<?xml version="1.0" encoding="UTF-8"?>
<experiments>
  <experiment name="s1" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="1">
    <setup>random-seed 3 setup</setup><go>go</go>
    <metrics><metric>map [t -> (list [view] of t [[who] of partner] of t)] sort turtles</metric></metrics>
    <constants><enumeratedValueSet variable="team-size"><value value="6"></value></enumeratedValueSet></constants>
  </experiment>
  <experiment name="s4" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true" timeLimit="40">
    <setup>random-seed 3 setup</setup><go>go</go>
    <metrics><metric>map [t -> [view] of t] sort turtles</metric><metric>disagreement</metric><metric>team-mean</metric></metrics>
    <constants><enumeratedValueSet variable="team-size"><value value="6"></value></enumeratedValueSet>
    <enumeratedValueSet variable="mu"><value value="0.3"></value></enumeratedValueSet>
    <enumeratedValueSet variable="update-order"><value value="&quot;one pair at a time&quot;"></value><value value="&quot;everyone at once&quot;"></value></enumeratedValueSet>
    <enumeratedValueSet variable="stop-rule"><value value="&quot;until agreement&quot;"></value></enumeratedValueSet>
    <enumeratedValueSet variable="initialization"><value value="&quot;spread evenly&quot;"></value><value value="&quot;two camps&quot;"></value></enumeratedValueSet></constants>
  </experiment>
  <experiment name="many" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="1">
    <setup>random-seed 3 setup</setup><go>run-many-teams</go>
    <metrics><metric>0</metric></metrics>
    <constants><enumeratedValueSet variable="team-size"><value value="6"></value></enumeratedValueSet>
    <enumeratedValueSet variable="mu"><value value="0.3"></value></enumeratedValueSet>
    <enumeratedValueSet variable="update-order"><value value="&quot;one pair at a time&quot;"></value></enumeratedValueSet>
    <enumeratedValueSet variable="stop-rule"><value value="&quot;until agreement&quot;"></value></enumeratedValueSet>
    <enumeratedValueSet variable="initialization"><value value="&quot;spread evenly&quot;"></value></enumeratedValueSet></constants>
  </experiment>
</experiments>
